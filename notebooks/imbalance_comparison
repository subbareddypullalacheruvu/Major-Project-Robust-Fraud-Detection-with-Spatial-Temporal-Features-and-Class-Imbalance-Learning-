        }
      ],
      "source": [
        "# SMOTE - oversample the minority class on the train fold only, never touches test\n",
        "!pip install -q imbalanced-learn\n",
        "from imblearn.over_sampling import SMOTE\n",
        "\n",
        "# 1. Fit SMOTE on the scaled train fold only - it generates synthetic fraud\n",
        "#    cases by interpolating between real fraud cases' nearest neighbors\n",
        "smote = SMOTE(random_state=42)\n",
        "X_train_smote, y_train_smote = smote.fit_resample(X_train_scaled, y_train)\n",
        "\n",
        "# 2. Sanity check - class counts should now be roughly 50/50 in the resampled train set\n",
        "print(\"Before SMOTE:\", X_train_scaled.shape, y_train.value_counts().to_dict())\n",
        "print(\"After SMOTE:\", X_train_smote.shape, pd.Series(y_train_smote).value_counts().to_dict())\n",
        "\n",
        "# 3. Plain Logistic Regression, no class weighting this time - SMOTE already balanced the data\n",
        "model_smote = LogisticRegression(max_iter=1000)\n",
        "model_smote.fit(X_train_smote, y_train_smote)\n",
        "\n",
        "# 4. Score on the untouched, still-imbalanced test set - same three metrics as every other strategy\n",
        "proba_smote = model_smote.predict_proba(X_test_scaled)[:, 1]\n",
        "pred_smote = (proba_smote >= 0.5).astype(int)\n",
        "\n",
        "pr_auc_smote = average_precision_score(y_test, proba_smote)\n",
        "f2_smote = fbeta_score(y_test, pred_smote, beta=2)\n",
        "mcc_smote = matthews_corrcoef(y_test, pred_smote)\n",
        "\n",
        "print(f\"PR-AUC: {pr_auc_smote:.4f}\")\n",
        "print(f\"F2:     {f2_smote:.4f}\")\n",
        "print(f\"MCC:    {mcc_smote:.4f}\")\n"
      ],
