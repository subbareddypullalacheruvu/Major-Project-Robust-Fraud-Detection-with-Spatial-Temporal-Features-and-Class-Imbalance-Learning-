      "source": [
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import average_precision_score, fbeta_score, matthews_corrcoef, precision_score, recall_score, confusion_matrix\n",
        "\n",
        "X_train = sparkov_train[FEATURES]\n",
        "y_train = sparkov_train[TARGET]\n",
        "X_test = sparkov_test[FEATURES]\n",
        "y_test = sparkov_test[TARGET]\n",
        "\n",
        "scaler = StandardScaler()\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_test_scaled = scaler.transform(X_test)\n",
        "\n",
        "model_control = LogisticRegression(max_iter=1000)\n",
        "model_control.fit(X_train_scaled, y_train)\n",
        "\n",
        "proba_control = model_control.predict_proba(X_test_scaled)[:, 1]\n",
        "pred_control = (proba_control >= 0.5).astype(int)\n",
        "\n",
        "pr_auc_control = average_precision_score(y_test, proba_control)\n",
        "f2_control = fbeta_score(y_test, pred_control, beta=2)\n",
        "mcc_control = matthews_corrcoef(y_test, pred_control)\n",
        "\n",
        "print(f\"PR-AUC: {pr_auc_control:.4f}\")\n",
        "print(f\"F2:     {f2_control:.4f}\")\n",
        "print(f\"MCC:    {mcc_control:.4f}\")\n"
      ],
      "id": "ugmx1VhN22RE"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "OaTa1pCA22RE"
      },
      "source": [
        "We use this as the reference point every imbalance-handling strategy\n",
        "below is compared against: plain `LogisticRegression`, default 0.5\n",
        "threshold, no resampling or weighting, on our finalized six-feature set. It\n",
        "reproduces `feature_engineering.ipynb`'s final refinement row exactly\n",
        "(PR-AUC 0.3510, F2 0.2137, MCC 0.3525), as we expected — same features,\n",
