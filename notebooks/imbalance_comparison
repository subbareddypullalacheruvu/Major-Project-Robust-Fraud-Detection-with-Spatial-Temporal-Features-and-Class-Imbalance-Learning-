        "import sys\n",
        "sys.path.append('/content/Major-Project-Robust-Fraud-Detection-with-Spatial-Temporal-Features-and-Class-Imbalance-Learning-')\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from src.split import split_sparkov\n",
        "from src.utils import fit_category_risk, apply_category_risk, add_prev_txn_features\n",
        "\n",
        "# leak-free split\n",
        "sparkov_train, sparkov_test = split_sparkov()\n",
        "sparkov_train = sparkov_train.drop(columns=[\"Unnamed: 0\"])\n",
        "sparkov_test = sparkov_test.drop(columns=[\"Unnamed: 0\"])\n",
        "\n",
        "# category_risk - fit on train only, apply to both\n",
        "category_risk_lookup = fit_category_risk(sparkov_train, category_column=\"category\", label_column=\"is_fraud\")\n",
        "sparkov_train[\"category_risk\"] = apply_category_risk(sparkov_train, \"category\", category_risk_lookup)\n",
        "sparkov_test[\"category_risk\"] = apply_category_risk(sparkov_test, \"category\", category_risk_lookup)\n",
        "\n",
        "# is_night flag (10pm-3am)\n",
        "night_hours = [22, 23, 0, 1, 2, 3]\n",
        "sparkov_train[\"is_night\"] = sparkov_train[\"trans_date_trans_time\"].dt.hour.isin(night_hours).astype(int)\n",
        "sparkov_test[\"is_night\"] = sparkov_test[\"trans_date_trans_time\"].dt.hour.isin(night_hours).astype(int)\n",
        "\n",
        "# amt_log\n",
        "sparkov_train[\"amt_log\"] = np.log1p(sparkov_train[\"amt\"])\n",
        "sparkov_test[\"amt_log\"] = np.log1p(sparkov_test[\"amt\"])\n",
        "\n",
        "# implied velocity - computed across the concatenated timeline so each\n",
        "# cardholder's boundary transaction still has a real previous transaction\n",
        "sparkov_train[\"_split\"] = \"train\"\n",
        "sparkov_test[\"_split\"] = \"test\"\n",
        "combined = pd.concat([sparkov_train, sparkov_test], ignore_index=True)\n",
        "combined = add_prev_txn_features(\n",
        "    combined,\n",
        "    id_column=\"cc_num\",\n",
        "    time_column=\"trans_date_trans_time\",\n",
        "    lat_column=\"merch_lat\",\n",
        "    lon_column=\"merch_long\",\n",
        ")\n",
        "sparkov_train = combined[combined[\"_split\"] == \"train\"].drop(columns=[\"_split\"])\n",
        "sparkov_test = combined[combined[\"_split\"] == \"test\"].drop(columns=[\"_split\"])\n",
        "\n",
        "for col in [\"dist_from_prev_txn_km\", \"time_gap_hours\", \"implied_velocity_kmh\"]:\n",
        "    sparkov_train[col] = sparkov_train[col].fillna(0)\n",
        "    sparkov_test[col] = sparkov_test[col].fillna(0)\n",
        "\n",
        "sparkov_train[\"velocity_log\"] = np.log1p(sparkov_train[\"implied_velocity_kmh\"])\n",
        "sparkov_test[\"velocity_log\"] = np.log1p(sparkov_test[\"implied_velocity_kmh\"])\n",
        "\n",
        "# age and gender_flag - added during the feature-set refinement stage; city_pop\n",
        "# is excluded from FEATURES (kept in the dataframe only for reference) since two\n",
        "# separate ablations showed it carries no independent signal\n",
        "sparkov_train[\"dob\"] = pd.to_datetime(sparkov_train[\"dob\"])\n",
        "sparkov_test[\"dob\"] = pd.to_datetime(sparkov_test[\"dob\"])\n",
        "sparkov_train[\"age\"] = (sparkov_train[\"trans_date_trans_time\"] - sparkov_train[\"dob\"]).dt.days / 365.25\n",
        "sparkov_test[\"age\"] = (sparkov_test[\"trans_date_trans_time\"] - sparkov_test[\"dob\"]).dt.days / 365.25\n",
        "\n",
        "sparkov_train[\"gender_flag\"] = (sparkov_train[\"gender\"] == \"M\").astype(int)\n",
        "sparkov_test[\"gender_flag\"] = (sparkov_test[\"gender\"] == \"M\").astype(int)\n",
        "\n",
        "# confirm we're back to where feature_engineering.ipynb's refinement stage left off\n",
        "FEATURES = [\"amt_log\", \"category_risk\", \"is_night\", \"velocity_log\", \"age\", \"gender_flag\"]\n",
        "TARGET = \"is_fraud\"\n",
        "\n",
        "print(\"Train shape:\", sparkov_train.shape)\n",
        "print(\"Test shape:\", sparkov_test.shape)\n",
        "print(f\"Train fraud rate: {sparkov_train[TARGET].mean() * 100:.3f}%\")\n",
        "print(f\"Test fraud rate: {sparkov_test[TARGET].mean() * 100:.3f}%\")\n",
        "print(\"Missing values in final features (train):\", sparkov_train[FEATURES].isnull().sum().sum())\n",
        "print(\"Missing values in final features (test):\", sparkov_test[FEATURES].isnull().sum().sum())"
