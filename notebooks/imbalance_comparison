      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Before SMOTE: (1296675, 6) {0: 1289169, 1: 7506}\n",
            "After SMOTE: (2578338, 6) {0: 1289169, 1: 1289169}\n",
            "PR-AUC: 0.3560\n",
            "F2:     0.0805\n",
            "MCC:    0.1005\n"
