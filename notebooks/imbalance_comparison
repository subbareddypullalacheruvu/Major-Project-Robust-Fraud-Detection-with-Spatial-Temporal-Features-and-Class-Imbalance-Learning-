        "# we already generated SMOTE's resampled data (X_train_smote, y_train_smote) earlier\n",
        "# for Logistic Regression - reusing it here rather than re-running SMOTE, since it's\n",
        "# the same synthetic training set regardless of which model trains on it downstream.\n",
        "# RF is scale-invariant, so this works fine on the scaled features; predicting on\n",
        "# X_test_scaled (not X_test) just keeps train/test in the same feature space.\n",
        "model_rf_smote = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)\n",
        "model_rf_smote.fit(X_train_smote, y_train_smote)\n",
        "\n",
